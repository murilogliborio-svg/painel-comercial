# Copie para .env e preencha. Nada aqui tem valor padrão inseguro: variável
# ausente vira erro explícito no boot (ver src/config.ts) ou desliga a
# funcionalidade correspondente (I.A. e WhatsApp) em vez de fingir que está ligada.

# --- obrigatórias para subir ---------------------------------------------

# Domínio público de VERDADE deste serviço, com https://. Precisa bater
# exatamente com o que o navegador usa, senão o cookie de sessão é descartado.
APP_URL=https://sdr.suaempresa.com.br

# Chave usada no hash de todas as senhas. Gere com: openssl rand -base64 48
# Trocar depois invalida todos os logins. Guarde fora do backup do banco.
SECRET_KEY=

# Domínio que o Caddy vai emitir certificado TLS para (docker-compose.yml).
DOMINIO=sdr.suaempresa.com.br

# Primeiro administrador, criado automaticamente no primeiro boot.
ADMIN_EMAIL=voce@suaempresa.com.br
ADMIN_SENHA=

# --- I.A.: sem isto, a geração automática de mensagem fica desligada ------
# a fila de leads devidos simplesmente não gera texto novo até você preencher.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- WhatsApp: sem as três, roda em MODO SIMULADO -------------------------
# (grava a mensagem como enviada, sem tocar na API real — seguro para testar
# a esteira inteira antes de falar com cliente de verdade). Vêm do app que
# você cria em business.facebook.com > WhatsApp > Configuração da API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Você escolhe este valor (qualquer string) e cola o mesmo na tela de
# configuração do webhook, no painel da Meta.
WHATSAPP_VERIFY_TOKEN=

# --- opcionais --------------------------------------------------------------
# SESSION_MAX_HOURS=12
# SESSION_IDLE_MINUTES=60
# RETENCAO_AUDITORIA_DIAS=365
# VARREDURA_MINUTOS=5
