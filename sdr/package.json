{
  "name": "sdr-ia",
  "version": "1.0.0",
  "private": true,
  "description": "SDR de I.A. para aquecimento de clientes, com acesso do time comercial",
  "type": "module",
  "engines": { "node": ">=22.6.0" },
  "scripts": {
    "start": "node --no-warnings --experimental-strip-types src/main.ts",
    "dev": "node --no-warnings --experimental-strip-types --watch src/main.ts",
    "migrar": "node --no-warnings --experimental-strip-types src/main.ts migrar",
    "criar-admin": "node --no-warnings --experimental-strip-types src/main.ts criar-admin",
    "limpar": "node --no-warnings --experimental-strip-types src/main.ts limpar",
    "test": "node --no-warnings --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
